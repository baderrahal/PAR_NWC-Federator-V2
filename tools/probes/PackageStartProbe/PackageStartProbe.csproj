<Project Sdk="Microsoft.NET.Sdk">

  <!--
    F214, F210-R1, 2026-10-18. A probe that runs INSIDE Navisworks, in DisciplineProbe's shape, started through the
    automation API by tools\probes\PackageStartProbe\probe-package-start.ps1. Its parent mode starts the helper of
    Helper\, which starts a second Navisworks and hands its child mode the package to run. It references no project of
    this repo and saves nothing.

        dotnet build tools\probes\PackageStartProbe\PackageStartProbe.csproj -c Release
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>PackageStartProbe</AssemblyName>
    <RootNamespace>PackageStartProbe</RootNamespace>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <NavisworksPath Condition="'$(NavisworksPath)' == ''">C:\Program Files\Autodesk\Navisworks Manage 2025</NavisworksPath>
    <NavisworksPath>$(NavisworksPath.TrimEnd('\'))</NavisworksPath>
    <NavisworksApiDll>$(NavisworksPath)\Autodesk.Navisworks.Api.dll</NavisworksApiDll>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Autodesk.Navisworks.Api">
      <HintPath>$(NavisworksApiDll)</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Helper\**" />
    <None Remove="Helper\**" />
  </ItemGroup>

  <Target Name="CheckNavisworks" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(NavisworksApiDll)')" Text="Autodesk.Navisworks.Api.dll was not found at $(NavisworksApiDll). Pass -p:NavisworksPath with the real install folder." />
  </Target>

</Project>
