<Project Sdk="Microsoft.NET.Sdk">

  <!--
    F223, Q207, 2026-10-18. A probe that runs INSIDE Navisworks, in AppendBoxProbe's shape, started through the
    automation API by tools\probes\AutoSaveProbe\probe-auto-save.ps1. It reads every option of Navisworks' Auto-Save
    set through LcUOption, and in its timer mode points the autosaves at a folder of the probe's own, sets the time
    between saves short, makes the document hold unsaved changes by appending a copy of an NWC, and reads whether an
    autosave is written with the switch on, then off, then on again, before it puts every option back as it read it.
    It references no project of this repo and saves nothing itself.

        dotnet build tools\probes\AutoSaveProbe\AutoSaveProbe.csproj -c Release
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>AutoSaveProbe</AssemblyName>
    <RootNamespace>AutoSaveProbe</RootNamespace>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <NavisworksPath Condition="'$(NavisworksPath)' == ''">C:\Program Files\Autodesk\Navisworks Manage 2025</NavisworksPath>
    <NavisworksPath>$(NavisworksPath.TrimEnd('\'))</NavisworksPath>
    <NavisworksApiDll>$(NavisworksPath)\Autodesk.Navisworks.Api.dll</NavisworksApiDll>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Autodesk.Navisworks.Api">
      <HintPath>$(NavisworksApiDll)</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <Target Name="CheckNavisworks" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(NavisworksApiDll)')" Text="Autodesk.Navisworks.Api.dll was not found at $(NavisworksApiDll). Pass -p:NavisworksPath with the real install folder." />
  </Target>

</Project>
