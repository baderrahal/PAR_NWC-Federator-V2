# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
artifacts/

# NOT build/. That folder holds install.ps1, which is the only way the add-in and
# the twelve library DLLs reach the 27 machines that run this. It was ignored here
# from the first commit and had never been committed, so it was one clean away from
# being lost. bin/, obj/, Debug/, Release/ and artifacts/ already cover build output.

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# Rider and VS Code
.idea/
*.sln.iml
.vscode/

# NuGet
*.nupkg
*.snupkg
packages/
!packages/build/
project.lock.json
project.assets.json

