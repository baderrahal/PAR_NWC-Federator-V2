<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Federator.Core</AssemblyName>
    <RootNamespace>Federator.Core</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />

    <!-- The workbook writer lives here rather than in the add-in, so the tests write a
         real xlsx and read it back without Navisworks. Checked on 2026-08-31: builds
         clean against net48, and none of its twelve DLLs collide with a file the
         Navisworks install ships. See docs/history/scan.md section 4h. -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- F84's list of every category the client's Revit models really carry. EMBEDDED
         and not loose, because the bundle copies what install.ps1 names and a loose file
         beside the assembly is a file that arrives on 26 machines and not on the 27th.
         It is a FILE and not a list in a method because it is read off the client's
         models and changes when their models do, which is the opposite of UnitTable. -->
    <EmbeddedResource Include="Exchange\revit-categories.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- A BuildingGroup is built by the grouping and nothing else, which is right. The
         name collision guard has to be tested against two groups that would be written to
         one name, and the four grouping modes cannot currently produce that pair, so the
         test constructs them directly rather than the guard going untested. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Federator.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
