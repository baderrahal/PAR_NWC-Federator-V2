<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Federator.Addin.Ui.FederatorWindow"
        Title="Parsons NWC Federator"
        Height="720" Width="1080"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="MinWidth" Value="90" />
        </Style>
        <Style x:Key="StepHeading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <!-- One grey line under a tick box saying what it costs. Indented under the box
             so it reads as belonging to it, and wrapped so it never runs off the edge. -->
        <Style x:Key="TickHelp" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#707070" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="20,1,0,8" />
        </Style>
        <!-- A grey line under a TABLE saying what the tool noticed. Its own style and not
             TickHelp, because TickHelp is indented 20 to sit under a tick box and a line
             under a table starts at the edge of the table. F71. -->
        <Style x:Key="FindingLine" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#707070" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <!-- The mark on the two that destroy something. A mark rather than capitals,
             because capitals in every label made all of them shout equally. -->
        <Style x:Key="WarningMark" TargetType="TextBlock">
            <Setter Property="Text" Value="!" />
            <Setter Property="Foreground" Value="#C00000" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">

        <!-- Bottom: run, progress and log -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0"
                Padding="0,8,0,0" Margin="0,8,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button x:Name="RunButton" Content="Run" Click="OnRun"
                            MinWidth="120" FontWeight="Bold" Margin="0,0,8,0" />
                    <Button x:Name="OpenLogFolderButton" Content="Open log folder" Click="OnOpenLogFolder"
                            MinWidth="120" />
                    <Button x:Name="CopyLogButton" Content="Copy log" Click="OnCopyLog" />
                    <Button x:Name="CloseButton" Content="Close" Click="OnClose" Margin="12,0,12,0" />
                </StackPanel>

                <!-- F62. Its own row, above the log and outside it, so the live line is
                     never clipped by the buttons beside it and never scrolls away when
                     the log pane follows the log. Trimmed rather than wrapped, so a long
                     line cannot push the log box down the window mid run. -->
                <TextBlock x:Name="ProgressLine" DockPanel.Dock="Top" Margin="0,0,0,6"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           Text="Pick a folder and press Scan." />

                <TextBox x:Name="LogBox" Height="150"
                         IsReadOnly="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="11" />
            </DockPanel>
        </Border>

        <TabControl x:Name="Pages" SelectionChanged="OnPageShown">
            <TabItem Header="NWC">
            <TabControl x:Name="Steps" SelectionChanged="OnStepShown">

            <!-- Step 1 -->
            <TabItem Header="1. Source">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource StepHeading}"
                               Text="Pick the folder of NWC files and press Scan. What was found and what is wrong with it are both reported here. Nothing below blocks a run or unticks anything, it is information and the decision is yours." />
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="Folder" />
                        <TextBox Grid.Column="1" x:Name="SourceFolderBox" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="Browse" Click="OnBrowseSource" />
                        <CheckBox Grid.Column="3" x:Name="IncludeSubfolders" Content="Include subfolders"
                                  IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <Button Grid.Column="4" Content="Scan" Click="OnScan" FontWeight="Bold" />
                    </Grid>

                    <TextBlock DockPanel.Dock="Bottom" x:Name="SourceSummary" Margin="0,6,0,0" />
                    <!-- The scan and its checks in one place. None of this blocks a run. -->
                    <Border DockPanel.Dock="Bottom" x:Name="FindingsPanel"
                            BorderBrush="#D0D0D0" BorderThickness="1" Background="#FFFDF5"
                            Padding="8" Margin="0,8,0,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" x:Name="CopyFindingsButton"
                                        Content="Copy findings" Click="OnCopyFindings" MinWidth="110" />
                                <TextBlock x:Name="FindingsHeading" FontWeight="Bold"
                                           VerticalAlignment="Center" Text="Findings" />
                            </DockPanel>
                            <TextBox x:Name="FindingsBox" Height="150"
                                     IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Segoe UI" FontSize="12" />
                        </DockPanel>
                    </Border>

                    <DataGrid x:Name="FilesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="False" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Use" Width="40"
                                                    Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}">
                                <DataGridCheckBoxColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="IsEnabled" Value="{Binding CanInclude}" />
                                    </Style>
                                </DataGridCheckBoxColumn.CellStyle>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn Header="File name" Width="330" IsReadOnly="True"
                                                Binding="{Binding FileName}" />
                            <DataGridTextColumn Header="Building" Width="80" IsReadOnly="True"
                                                Binding="{Binding Building}" />
                            <DataGridTextColumn Header="Discipline" Width="70" IsReadOnly="True"
                                                Binding="{Binding Discipline}" />
                            <DataGridTextColumn Header="Project" Width="60" IsReadOnly="True"
                                                Binding="{Binding Project}" />
                            <DataGridTextColumn Header="Originator" Width="70" IsReadOnly="True"
                                                Binding="{Binding Originator}" />
                            <DataGridTextColumn Header="Reason it cannot be read" Width="*" IsReadOnly="True"
                                                Binding="{Binding Reason}" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReadable}" Value="False">
                                        <Setter Property="Background" Value="#FFF3F3" />
                                        <Setter Property="Foreground" Value="#A00000" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Step 2 -->
            <TabItem Header="2. Grouping">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource StepHeading}"
                               Text="Choose how the files are gathered into federations. A group whose files disagree on the project code or the originator is blocked and names both files. The scan and its findings are on the Source step." />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Label Content="Make" VerticalAlignment="Center" />
                        <ComboBox x:Name="GroupingModeBox" MinWidth="320" VerticalAlignment="Center"
                                  SelectionChanged="OnGroupingModeChanged" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <CheckBox x:Name="RebuildExisting" Checked="OnRebuildToggled" Unchecked="OnRebuildToggled" />
                        <TextBlock x:Name="RebuildHelp" Style="{StaticResource TickHelp}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="GroupingSummary" Margin="0,6,0,0" />

                    <!-- F71. One line, and only when at least one group is about to build a
                         new NWF beside a file whose name is nearly the same. Collapsed the
                         rest of the time, because a panel that is always there saying
                         nothing is one nobody reads. Its text is composed in Core. -->
                    <TextBlock DockPanel.Dock="Bottom" x:Name="NearbyNwfLine"
                               Style="{StaticResource FindingLine}" Visibility="Collapsed" />

                    <!-- F130. The Shift range, said once under the list. Its words are in Core. -->
                    <TextBlock DockPanel.Dock="Bottom" x:Name="RunRangeHelp"
                               Style="{StaticResource FindingLine}" />

                    <DataGrid x:Name="GroupsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              PreviewKeyDown="OnGroupsGridKeyDown">
                        <DataGrid.Columns>
                            <!-- F130. A template column and not the stock tick box column, so the box
                                 itself takes the click and OnRunBoxClicked reads Shift at that click.
                                 Read only so the grid begins no edit that would swap the box out
                                 under the click. SortMemberPath keeps the column sortable as before.
                                 Named so OnGroupsGridKeyDown knows its cell, F130-R1. -->
                            <DataGridTemplateColumn x:Name="RunColumn" Header="Run" Width="40" IsReadOnly="True"
                                                    SortMemberPath="Include">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Top"
                                                  IsChecked="{Binding Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Click="OnRunBoxClicked" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="IsEnabled" Value="{Binding CanInclude}" />
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Building" Width="90" IsReadOnly="True"
                                                Binding="{Binding Building}" />
                            <DataGridTextColumn Header="Files" Width="50" IsReadOnly="True"
                                                Binding="{Binding FileCount}" />
                            <DataGridTextColumn Header="Disciplines" Width="200" IsReadOnly="True"
                                                Binding="{Binding Disciplines}" />
                            <!-- RunAsShown and not RunAs. The column carries the near miss
                                 sentence after the label, F71, and the counting reads the
                                 bare label so a widened one never reaches it. Wider than
                                 the other columns because the sentence names a file. -->
                            <DataGridTextColumn Header="Run as" Width="300" IsReadOnly="True"
                                                Binding="{Binding RunAsShown}" />
                            <DataGridTextColumn Header="Status" Width="*" IsReadOnly="True"
                                                Binding="{Binding Status}" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                        <Setter Property="Background" Value="#FFF3F3" />
                                        <Setter Property="Foreground" Value="#A00000" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Step 3 -->
            <TabItem Header="3. Outputs">
                <!-- The only step whose content is taller than the window. Measured at
                     1024x680, 1280x800 and 1600x1000 with tools\probes\probe-window-scroll.ps1
                     and cut off at all three, by 384, 264 and 87 pixels, which is why the
                     naming table and everything under it could not be reached. The other
                     three steps fit at all three sizes and are left alone, because a
                     ScrollViewer around a step whose grid is meant to fill stops it
                     filling. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource StepHeading}"
                               Text="One NWF folder and one NWD folder for the whole run, holding the NWF and NWD files alone. The logs and the reports go in a folder called Log beside them, made if it is not there, and nothing in it is overwritten or deleted. The name fields below fill the table, and any name in the table can be typed over. A name you type over is left alone when a pattern changes." />
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="NWF folder" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="NwfFolderBox"
                                 VerticalAlignment="Center" Margin="0,0,0,4"
                                 TextChanged="OnOutputFolderChanged" />
                        <Button Grid.Row="0" Grid.Column="2" Content="Browse" Click="OnBrowseNwf" Margin="4,0,0,4" />
                        <Label Grid.Row="1" Grid.Column="0" Content="NWD folder" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="NwdFolderBox"
                                 VerticalAlignment="Center" Margin="0,0,0,4"
                                 TextChanged="OnOutputFolderChanged" />
                        <Button Grid.Row="1" Grid.Column="2" Content="Browse" Click="OnBrowseNwd" Margin="4,0,0,4" />
                        <!-- The NWD, the client page and the photos used to be three tick
                             boxes. A weekly run wants all three every time, so they are
                             fixed on and are not a decision any more. -->
                        <Label Grid.Row="5" Grid.Column="0" Content="Logo" />
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="LogoBox"
                                 VerticalAlignment="Center" />
                        <Button Grid.Row="5" Grid.Column="2" Content="Browse" Click="OnBrowseLogo" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource TickHelp}"
                                   Text="Starts as the Navisworks logo, which is what the client accepts. Clear it for none." />
                    </Grid>

                    <!-- Everything below here is a decision a weekly run does not have to
                         make. It is collapsed, with the answer already chosen, so the
                         Outputs step is two folders and the logo. -->
                    <Expander DockPanel.Dock="Top" Header="More, rarely changed"
                              IsExpanded="False" Margin="0,0,0,8">
                        <Border BorderBrush="#D0D0D0" BorderThickness="1" Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.ColumnSpan="5">
                                    <CheckBox x:Name="DateTheNwd" IsChecked="False"
                                              Content="Date the NWD so every week is kept"
                                              Checked="OnNamingToggled" Unchecked="OnNamingToggled" />
                                    <TextBlock Style="{StaticResource TickHelp}"
                                               Text="Without this, only the latest week exists." />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.ColumnSpan="5">
                                    <CheckBox x:Name="WriteClashXml" IsChecked="False"
                                              Content="Write a clash XML beside each workbook"
                                              Checked="OnXmlChanged" Unchecked="OnXmlChanged" />
                                    <TextBlock Style="{StaticResource TickHelp}"
                                               Text="One extra file per building, under a megabyte." />
                                </StackPanel>

                                <!-- F150. The label and the grey line are read off Core,
                                     OtherItemsInPictures, and the default off ImageOptions. -->
                                <StackPanel Grid.Row="2" Grid.ColumnSpan="5">
                                    <CheckBox x:Name="GhostOtherItems"
                                              Checked="OnImageSettingChanged" Unchecked="OnImageSettingChanged" />
                                    <TextBlock x:Name="GhostOtherItemsHelp" Style="{StaticResource TickHelp}" />
                                </StackPanel>

                                <Label Grid.Row="3" Grid.Column="0" Content="Photo size" VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="ImagePixelsBox"
                                         MinWidth="70" VerticalAlignment="Center" Margin="0,0,12,4"
                                         TextChanged="OnImageSettingChanged" />
                                <Label Grid.Row="3" Grid.Column="2" Content="At most per test, 0 for none. Every test gets at most 150 at A, 100 at B, 50 at C"
                                       VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="3" x:Name="ImageCapBox"
                                         MinWidth="70" VerticalAlignment="Center" Margin="0,0,0,4"
                                         TextChanged="OnImageSettingChanged" />

                                <Label Grid.Row="4" Grid.Column="0" Content="Photo of" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4"
                                            Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="ImageNew" Content="New" Margin="0,0,10,0"
                                              Checked="OnImageSettingChanged" Unchecked="OnImageSettingChanged" />
                                    <CheckBox x:Name="ImageActive" Content="Active" Margin="0,0,10,0"
                                              Checked="OnImageSettingChanged" Unchecked="OnImageSettingChanged" />
                                    <CheckBox x:Name="ImageReviewed" Content="Reviewed" Margin="0,0,10,0"
                                              Checked="OnImageSettingChanged" Unchecked="OnImageSettingChanged" />
                                    <CheckBox x:Name="ImageApproved" Content="Approved" Margin="0,0,10,0"
                                              Checked="OnImageSettingChanged" Unchecked="OnImageSettingChanged" />
                                    <CheckBox x:Name="ImageResolved" Content="Resolved"
                                              Checked="OnImageSettingChanged" Unchecked="OnImageSettingChanged" />
                                </StackPanel>

                                <TextBlock Grid.Row="5" Grid.ColumnSpan="5" x:Name="ImageSummary"
                                           Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#606060"
                                           Text="Photos on." />
                            </Grid>
                        </Border>
                    </Expander>

                    <!-- The four fields this tool supplies rather than reads out of a file
                         name, plus the code used when a group covers several buildings.
                         Defaults, not constants. -->
                    <Border DockPanel.Dock="Top" BorderBrush="#D0D0D0" BorderThickness="1"
                            Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.ColumnSpan="7" Margin="0,0,0,6"
                                       TextWrapping="Wrap"
                                       Text="The name is project, originator, building, level, discipline, type, number. The first three come from the file names. These four are supplied, because the files in one group can disagree on them and outputs overwrite. The last is used when a group covers several buildings. Change any of them." />

                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Level" FontWeight="Bold" Margin="4,0,4,2" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Discipline" FontWeight="Bold" Margin="4,0,4,2" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="Type" FontWeight="Bold" Margin="4,0,4,2" />
                            <TextBlock Grid.Row="1" Grid.Column="4" Text="Number" FontWeight="Bold" Margin="4,0,4,2" />
                            <TextBlock Grid.Row="1" Grid.Column="5" Text="All buildings" FontWeight="Bold" Margin="4,0,4,2" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="NWF" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="NwfLevel" Width="70" Margin="4,1" TextChanged="OnNamingChanged" />
                            <TextBox Grid.Row="2" Grid.Column="2" x:Name="NwfDiscipline" Width="70" Margin="4,1" TextChanged="OnNamingChanged" />
                            <TextBox Grid.Row="2" Grid.Column="3" x:Name="NwfType" Width="70" Margin="4,1" TextChanged="OnNamingChanged" />
                            <TextBox Grid.Row="2" Grid.Column="4" x:Name="NwfNumber" Width="80" Margin="4,1" TextChanged="OnNamingChanged" />
                            <TextBox Grid.Row="2" Grid.Column="5" x:Name="NwfAllBuildings" Width="90" Margin="4,1" TextChanged="OnNamingChanged" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="NWD" VerticalAlignment="Center" />
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="NwdLevel" Width="70" Margin="4,1" TextChanged="OnNamingChanged" />
                            <TextBox Grid.Row="3" Grid.Column="2" x:Name="NwdDiscipline" Width="70" Margin="4,1" TextChanged="OnNamingChanged" />
                            <TextBox Grid.Row="3" Grid.Column="3" x:Name="NwdType" Width="70" Margin="4,1" TextChanged="OnNamingChanged" />
                            <TextBox Grid.Row="3" Grid.Column="4" x:Name="NwdNumber" Width="80" Margin="4,1" TextChanged="OnNamingChanged" />
                            <TextBox Grid.Row="3" Grid.Column="5" x:Name="NwdAllBuildings" Width="90" Margin="4,1" TextChanged="OnNamingChanged" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Workbook" VerticalAlignment="Center" />
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="WorkbookLevel" Width="70" Margin="4,1" TextChanged="OnNamingChanged" />
                            <TextBox Grid.Row="4" Grid.Column="2" x:Name="WorkbookDiscipline" Width="70" Margin="4,1" TextChanged="OnNamingChanged" />
                            <TextBox Grid.Row="4" Grid.Column="3" x:Name="WorkbookType" Width="70" Margin="4,1" TextChanged="OnNamingChanged" />
                            <TextBox Grid.Row="4" Grid.Column="4" x:Name="WorkbookNumber" Width="80" Margin="4,1" TextChanged="OnNamingChanged" />
                            <TextBox Grid.Row="4" Grid.Column="5" x:Name="WorkbookAllBuildings" Width="90" Margin="4,1" TextChanged="OnNamingChanged" />
                        </Grid>
                    </Border>

                    <TextBlock DockPanel.Dock="Top" x:Name="NamePreview" Margin="0,0,0,8"
                               TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" />
                    <TextBlock DockPanel.Dock="Bottom" x:Name="OutputsSummary" Margin="0,6,0,0" />
                    <DataGrid x:Name="OutputsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              CellEditEnding="OnNameEdited">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Building" Width="90" IsReadOnly="True"
                                                Binding="{Binding Building}" />
                            <DataGridTextColumn Header="Files" Width="50" IsReadOnly="True"
                                                Binding="{Binding FileCount}" />
                            <DataGridTextColumn Header="NWF name" Width="250"
                                                Binding="{Binding NwfName, UpdateSourceTrigger=LostFocus}" />
                            <DataGridTextColumn Header="NWD name" Width="250"
                                                Binding="{Binding NwdName, UpdateSourceTrigger=LostFocus}" />
                            <DataGridTextColumn Header="Workbook name" Width="250"
                                                Binding="{Binding WorkbookName, UpdateSourceTrigger=LostFocus}" />
                            <DataGridTextColumn Header="Edited" Width="55" IsReadOnly="True"
                                                Binding="{Binding EditedMark}" />
                            <DataGridTextColumn Header="Status" Width="*" IsReadOnly="True"
                                                Binding="{Binding Status}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                </ScrollViewer>
            </TabItem>


            <!-- Step 4. The clash XML, the two boxes that destroy data, the two hand
                 buttons, and the second way to run, on the file that is open. -->
            <TabItem Header="4. Clash">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource StepHeading}"
                               Text="Press Run on any step. The run does the whole job for every ticked group: append, save the NWF, build the sets, create the tests, run them, save the NWF again, publish the NWD, then take the pictures and write the reports. The clash matrix is built into the tool. A test of it already saved in an NWF runs where it sits, keeping its results." />
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- F155. The drop down is the one source of a run's tolerance and its
                             only control, 25, 50 and 75 mm, 25 selected when the window opens.
                             The entries, the label and the grey line are read off Core in the
                             constructor and never typed here. -->
                        <Label Grid.Row="0" Grid.Column="0" x:Name="ToleranceLabel" />
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ToleranceBox" MinWidth="200"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ToleranceHelp"
                                   Style="{StaticResource TickHelp}" />
                    </Grid>

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- F72. Visible rather than under an expander, because a weekly
                             run genuinely has to choose: it writes statuses into the NWF,
                             which is the only record of what has been fixed. It is NOT
                             under Things that destroy data, because nothing is destroyed,
                             only New and Active ever move and a person moves one back in
                             one click. Its help line is filled in the constructor from the
                             size setting, never typed here, because two copies of 150
                             drift and the XAML copy is the one nothing can test. -->
                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                            <CheckBox x:Name="MarkPenetrations" IsChecked="False" />
                            <TextBlock x:Name="MarkPenetrationsHelp" Style="{StaticResource TickHelp}" />
                        </StackPanel>

                        <!-- F72b. The second rule that moves a clash to Reviewed, a LIST and
                             not a judgement, off by default for the same reason the box
                             above is. Its label and grey line are read off Core in the
                             constructor and never typed here. The pairs file is picked in
                             the grid above, beside the clash XML. -->
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,8">
                            <CheckBox x:Name="MarkByDesign" IsChecked="False" />
                            <TextBlock x:Name="MarkByDesignHelp" Style="{StaticResource TickHelp}" />
                        </StackPanel>

                        <!-- Q72. A set already in the NWF keeps the question it was built
                             with, so a value corrected in the picked file since then never
                             reaches it. Off by default because it changes the NWF, and NOT
                             under the destroy data expander because it destroys nothing:
                             5v measured that the clash tests pointing at a replaced set
                             keep their results and their statuses. -->
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,8">
                            <CheckBox x:Name="RebuildDriftedSets" IsChecked="False" />
                            <TextBlock x:Name="RebuildDriftedSetsHelp" Style="{StaticResource TickHelp}" />
                        </StackPanel>



                        <!-- F136, Bader's word of 2026-10-05. Unticked, no group makes a
                             saved viewpoint and none can fail at them. Its label, its grey
                             line and whether it starts ticked are read off Core in the
                             constructor and never typed here. -->
                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,8">
                            <CheckBox x:Name="MakeViewpoints" />
                            <TextBlock x:Name="MakeViewpointsHelp" Style="{StaticResource TickHelp}" />
                        </StackPanel>

                        <!-- The two that destroy data. Collapsed and on their own, because
                             they do not belong beside ordinary output options. -->
                        <Expander Grid.Row="5" Grid.ColumnSpan="2" IsExpanded="False"
                                  Header="Things that destroy data" Margin="0,0,0,8">
                            <StackPanel Margin="20,4,0,0">
                                <!-- One StackPanel each, never two boxes in one, because the
                                     help line is read as the one beside its own box. -->
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource WarningMark}" />
                                        <CheckBox x:Name="ApplyFileSettings" IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Content="Apply the file's settings to existing tests" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource TickHelp}"
                                               Text="Changes which clashes those tests find. Statuses are kept. Differences are listed either way." />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </Grid>

                    <!-- The second way to run. A federation that already exists needs no
                         scan, no source folder and no grouping, because everything the run
                         needs is on the file that is open. -->
                    <Border DockPanel.Dock="Top" BorderBrush="#FF7A9CC6" BorderThickness="2"
                            Padding="8" Margin="0,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="RunOpenButton" Content="Run the open file"
                                        Click="OnRunOpenDocument" MinWidth="170"
                                        FontWeight="Bold" Margin="0,0,10,0" />
                                <TextBlock VerticalAlignment="Center" x:Name="OpenDocumentLine"
                                           TextWrapping="Wrap"
                                           Text="Nothing is open." />
                            </StackPanel>
                            <TextBlock Style="{StaticResource TickHelp}" Margin="0,6,0,0"
                                       Text="Always a Weekly run, never a First run. No XML means the saved tests run." />
                        </StackPanel>
                    </Border>

                    <!-- Neither of these is a step in the run. They are for trying one open
                         model by hand, which is why they are boxed off and named that way. -->
                    <Border DockPanel.Dock="Top" BorderBrush="#FFBBBBBB" BorderThickness="1"
                            Padding="8" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,10,0"
                                       Text="Not part of the run. Try the file above against the model open right now:" />
                            <Button x:Name="BuildSetsButton" Content="Sets into open model"
                                    Click="OnBuildSets" MinWidth="150" Margin="0,0,6,0" />
                            <Button x:Name="RunTestsButton" Content="Tests into open model"
                                    Click="OnRunTests" MinWidth="150" />
                        </StackPanel>
                    </Border>

                    <!-- F72c. The undo for the two rules above. A hand action on the open
                         document, like the two buttons above it, and it saves nothing. Its
                         label and grey line are read off Core in the constructor. -->
                    <Border DockPanel.Dock="Top" BorderBrush="#FFBBBBBB" BorderThickness="1"
                            Padding="8" Margin="0,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="UndoAutoReviewedButton" Click="OnUndoAutoReviewed"
                                        MinWidth="170" Margin="0,0,10,0" />
                                <TextBlock x:Name="UndoAutoReviewedLine" VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock x:Name="UndoAutoReviewedHelp" Style="{StaticResource TickHelp}"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- F86. The property probe. Not part of the run, reads and changes
                         nothing, and never opens an NWF. Its label and grey line are read
                         off Core in the constructor. -->
                    <Border DockPanel.Dock="Top" BorderBrush="#FFBBBBBB" BorderThickness="1"
                            Padding="8" Margin="0,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ProbeButton" Click="OnProbeModelProperties"
                                        MinWidth="170" Margin="0,0,10,0" />
                                <TextBlock x:Name="ProbeLine" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock x:Name="ProbeHelp" Style="{StaticResource TickHelp}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="SetsSummary" Margin="0,6,0,0"
                               Text="No file picked." />
                    <TextBox x:Name="SetsBox" IsReadOnly="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11" />
                </DockPanel>
            </TabItem>

            </TabControl>
            </TabItem>

            <!-- F188, Bader's answer 3 of Q174. The NWF page: the weekly work on an NWF that is built. Its
                 words, its tick boxes and what each needs are Core's, Federator.Core.Rerun.NwfPageSteps and
                 RefreshConfirm, read in the constructor and never typed here. -->
            <TabItem Header="NWF">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource StepHeading}" x:Name="NwfPageHeading" />

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" x:Name="PickedNwfLabel" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="PickedNwfBox" VerticalAlignment="Center"
                                 LostFocus="OnPickedNwfLostFocus" />
                        <Button Grid.Row="0" Grid.Column="2" Content="File" Click="OnBrowsePickedNwfFile" />
                        <Button Grid.Row="0" Grid.Column="3" Content="Folder" Click="OnBrowsePickedNwfFolder" />
                        <Label Grid.Row="1" Grid.Column="0" x:Name="RecentNwfLabel" />
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="RecentNwfBox" Margin="0,4,0,0"
                                  SelectionChanged="OnRecentNwfChosen" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="PickedNwfHelp"
                                   Style="{StaticResource FindingLine}" Margin="0,2,0,0" />
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" x:Name="NwfChangedHeading" FontWeight="Bold" Margin="0,6,0,2" />
                    <TextBox DockPanel.Dock="Top" x:Name="NwfChangedBox" IsReadOnly="True" Height="84"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" />

                    <Grid DockPanel.Dock="Top" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" x:Name="NwfToleranceLabel" />
                        <ComboBox Grid.Column="1" x:Name="NwfToleranceBox" MinWidth="200"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" x:Name="NwfToleranceHelp" Style="{StaticResource TickHelp}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                        <TextBlock x:Name="NwfStepsHeading" FontWeight="Bold" Margin="0,0,0,2" />
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="NwfStepRefresh" IsChecked="True" Margin="0,0,16,0"
                                      Click="OnNwfStepChanged" />
                            <CheckBox x:Name="NwfStepTests" IsChecked="True" Margin="0,0,16,0"
                                      Click="OnNwfStepChanged" />
                            <CheckBox x:Name="NwfStepPictures" IsChecked="True" Margin="0,0,16,0"
                                      Click="OnNwfStepChanged" />
                            <CheckBox x:Name="NwfStepViewpoints" IsChecked="True" Margin="0,0,16,0"
                                      Click="OnNwfStepChanged" />
                            <CheckBox x:Name="NwfStepReports" IsChecked="True" Margin="0,0,16,0"
                                      Click="OnNwfStepChanged" />
                        </StackPanel>
                        <TextBlock x:Name="NwfStepsHelp" Style="{StaticResource FindingLine}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="RunPickedNwfsButton" Content="Run" Click="OnRunPickedNwfs"
                                MinWidth="120" FontWeight="Bold" Margin="0,0,8,0" />
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" x:Name="NwfSummary" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock DockPanel.Dock="Top" x:Name="NwfRulesLine" Style="{StaticResource FindingLine}" />

                    <TextBlock DockPanel.Dock="Top" x:Name="NwfTableHeading" FontWeight="Bold" Margin="0,8,0,2" />
                    <DataGrid x:Name="NwfTable" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" MinHeight="90">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Test" Binding="{Binding Test}" Width="*" />
                            <DataGridTextColumn Header="New" Binding="{Binding New}" Width="70" />
                            <DataGridTextColumn Header="Active" Binding="{Binding Active}" Width="70" />
                            <DataGridTextColumn Header="Reviewed" Binding="{Binding Reviewed}" Width="80" />
                            <DataGridTextColumn Header="Approved" Binding="{Binding Approved}" Width="80" />
                            <DataGridTextColumn Header="Resolved" Binding="{Binding Resolved}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
