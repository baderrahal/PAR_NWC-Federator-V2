<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Federator.Addin</AssemblyName>
    <RootNamespace>Federator.Addin</RootNamespace>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The plugin is loaded by Navisworks, which supplies the entry point. -->
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>Parsons</Company>
    <Product>Parsons NWC Federator</Product>
  </PropertyGroup>

  <!-- Override on the command line when Navisworks sits elsewhere:
       dotnet build -p:NavisworksPath="D:\Autodesk\Navisworks Manage 2025" -->
  <PropertyGroup>
    <NavisworksPath Condition="'$(NavisworksPath)' == ''">C:\Program Files\Autodesk\Navisworks Manage 2025</NavisworksPath>

    <!-- A caller who types the folder with a trailing slash would otherwise build a path
         with two slashes in it. Trimming here means every path below is built once, the
         same way. -->
    <NavisworksPath>$(NavisworksPath.TrimEnd('\'))</NavisworksPath>

    <!-- Each referenced DLL named once, as a full path. The HintPath and the existence
         check below both use these, so they can never drift apart. -->
    <NavisworksApiDll>$(NavisworksPath)\Autodesk.Navisworks.Api.dll</NavisworksApiDll>
    <NavisworksClashDll>$(NavisworksPath)\Autodesk.Navisworks.Clash.dll</NavisworksClashDll>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <ProjectReference Include="..\Federator.Core\Federator.Core.csproj" />
  </ItemGroup>

  <!-- Copy local false. These live in the Navisworks install folder and the running
       application already has them loaded. Shipping a second copy in the bundle would
       load a second set of types and nothing would match. -->
  <ItemGroup>
    <Reference Include="Autodesk.Navisworks.Api">
      <HintPath>$(NavisworksApiDll)</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="Autodesk.Navisworks.Clash">
      <HintPath>$(NavisworksClashDll)</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
  </ItemGroup>

  <!--
    One direct existence test per referenced file, against its full path. Exists() is a
    direct path test, it does not search and it does not walk subfolders. Nothing in this
    build searches for a Navisworks file, and nothing here should be changed to.

    Each file is checked on its own so a missing Clash DLL says so by name, rather than
    falling through to a reference resolution warning and a pile of compile errors.
  -->
  <Target Name="CheckNavisworksPresent" BeforeTargets="ResolveAssemblyReferences">
    <Message Importance="low" Text="NavisworksPath  = $(NavisworksPath)" />
    <Message Importance="low" Text="Api DLL         = $(NavisworksApiDll)" />
    <Message Importance="low" Text="Clash DLL       = $(NavisworksClashDll)" />

    <Error Condition="!Exists('$(NavisworksApiDll)')"
           Text="Autodesk.Navisworks.Api.dll was not found at '$(NavisworksApiDll)'. NavisworksPath is '$(NavisworksPath)'. Set NavisworksPath to the Navisworks Manage 2025 install folder, for example -p:NavisworksPath=&quot;D:\Autodesk\Navisworks Manage 2025&quot;." />

    <Error Condition="!Exists('$(NavisworksClashDll)')"
           Text="Autodesk.Navisworks.Clash.dll was not found at '$(NavisworksClashDll)'. NavisworksPath is '$(NavisworksPath)'. Set NavisworksPath to the Navisworks Manage 2025 install folder, for example -p:NavisworksPath=&quot;D:\Autodesk\Navisworks Manage 2025&quot;." />
  </Target>

</Project>
