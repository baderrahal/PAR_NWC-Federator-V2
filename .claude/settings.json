{
  "permissions": {
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet build-server shutdown)",
      "PowerShell(dotnet build *)",
      "PowerShell(dotnet test *)",
      "PowerShell(dotnet build-server shutdown)",
      "Bash(powershell -ExecutionPolicy Bypass -File build/install.ps1)",
      "Bash(powershell -ExecutionPolicy Bypass -File build/install.ps1 *)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File build\\install.ps1)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File build\\install.ps1 *)",
      "Bash(powershell -ExecutionPolicy Bypass -File tools/loop/prepare-copy.ps1)",
      "Bash(powershell -ExecutionPolicy Bypass -File tools/loop/prepare-copy.ps1 *)",
      "Bash(powershell -ExecutionPolicy Bypass -File tools/loop/read-workbook.ps1 *)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File tools\\loop\\prepare-copy.ps1)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File tools\\loop\\prepare-copy.ps1 *)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File tools\\loop\\read-workbook.ps1 *)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File tools\\probes\\probe-clash-api.ps1 *)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File tools\\probes\\probe-clash-comments.ps1 *)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File tools\\probes\\probe-clash-images.ps1 *)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File tools\\probes\\probe-document-ready.ps1 *)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File tools\\probes\\probe-model-remove.ps1 *)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File tools\\probes\\probe-properties.ps1 *)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File tools\\probes\\probe-units.ps1 *)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File tools\\probes\\probe-viewpoints.ps1 *)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File tools\\probes\\probe-window-defaults.ps1 *)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File tools\\probes\\probe-window-labels.ps1 *)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File tools\\probes\\probe-window-scroll.ps1 *)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File tools\\probes\\drive-window-run.ps1 *)",
      "Bash(sh tools/checks/check-locals.sh *)",
      "Bash(sh tools/checks/check-imports.sh *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git fetch *)",
      "Bash(git merge --ff-only *)",
      "Bash(git pull --ff-only *)",
      "Bash(git add *)",
      "Bash(git commit -F *)",
      "Bash(git commit -q -F *)",
      "Bash(git push -u origin fix-*)",
      "Bash(git push origin --delete fix-*)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git ls-files *)",
      "Bash(git ls-remote *)",
      "Bash(git check-ignore *)",
      "Bash(git config --get *)",
      "Bash(gh pr create *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr merge *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * push * --force*)",
      "Bash(git -C * push * -f*)",
      "Bash(git * --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(git config core.hooksPath*)",
      "Bash(git config * core.hooksPath*)",
      "Bash(git -c core.hooksPath*)",
      "Bash(git reset --hard*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git clean *)",
      "Bash(git -C * clean *)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh pr merge --admin*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git -C * push --force*)",
      "PowerShell(git -C * push -f*)",
      "PowerShell(git -C * push * --force*)",
      "PowerShell(git -C * push * -f*)",
      "PowerShell(git * --no-verify*)",
      "PowerShell(git commit -n*)",
      "PowerShell(git commit * -n*)",
      "PowerShell(git config core.hooksPath*)",
      "PowerShell(git config * core.hooksPath*)",
      "PowerShell(git -c core.hooksPath*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git -C * reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git -C * clean *)",
      "PowerShell(gh pr merge * --admin*)",
      "PowerShell(gh pr merge --admin*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/refuse-protected-paths.sh\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/refuse-git-on-main.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/loop-gate.sh\""
          }
        ]
      }
    ]
  }
}
